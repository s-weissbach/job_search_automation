<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily local job search, every day 00:00. Install:
      cp scripts/io.jobsearch.daily.plist ~/Library/LaunchAgents/
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/io.jobsearch.daily.plist
  Remove with:
      launchctl bootout gui/$(id -u)/io.jobsearch.daily

  NOTE: this repo must NOT live under ~/Desktop, ~/Documents, or ~/Downloads.
  launchd invokes /bin/bash directly (not Terminal.app), and macOS TCC blocks
  that process from even getcwd()-ing into those folders, so the job fails
  with exit 126 before the script body runs. (Hit this on 2026-08-17.)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.jobsearch.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/stephanweissbach/Projects/job_search_automation/scripts/run_perry_local.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/stephanweissbach/Projects/job_search_automation</string>

    <!-- Start alongside pharmajob.io at midnight. LinkedIn/Indeed discovery
         can run while pharmajob.io scrapes; before querying its database,
         src/pharmajob_client.py waits for the real completion marker.
         launchd re-fires a missed run on wake; cron does not. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/stephanweissbach/Projects/job_search_automation/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/stephanweissbach/Projects/job_search_automation/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>

    <!-- Scraping + scoring can run long; don't let launchd treat it as hung. -->
    <key>ExitTimeOut</key>
    <integer>0</integer>
</dict>
</plist>
