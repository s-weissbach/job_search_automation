ANTHROPIC_API_KEY=your-key-here

# Optional: only needed if you want the score store to persist across runs
# and/or want high-score alert emails (see README "Score alert emails").
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: sends an email when a job scores above 90%. Reuses the same
# Resend account as the stephanweissbach.dev site.
RESEND_API_KEY=
JOB_ALERT_FROM_EMAIL=
JOB_ALERT_TO_EMAIL=
